#: includes/class-plugin.php:134
#, php-format
msgid "Connected. Breeder: %s"
msgstr "Połączono. Hodowla: %s"

#. translators: %s is the breeder slug entered in the settings form.
#: includes/class-plugin.php:138
#, php-format
msgid "Slug \"%s\" does not exist. Check the spelling (compare it with the profile URL in Velora)."
msgstr "Slug \"%s\" nie istnieje. Sprawdź pisownię (porównaj z URL profilu w Velorze)."

#: includes/class-plugin.php:143
msgid "The API server is not responding — check \"API base URL\"."
msgstr "Serwer API nie odpowiada — sprawdź \"API base URL\"."

#: includes/class-plugin.php:144
msgid "The server returned an unexpected response — check that \"API base URL\" points to the Velora API."
msgstr "Serwer odpowiedział nieoczekiwanie — sprawdź czy \"API base URL\" wskazuje Velora API."

#: includes/class-plugin.php:145
msgid "Network error"
msgstr "Błąd sieci"

#: includes/class-plugin.php:146
msgid "Enter the \"API base URL\"."
msgstr "Wpisz \"API base URL\"."

#: includes/class-plugin.php:147
msgid "Enter the \"Default breeder slug\"."
msgstr "Wpisz \"Default breeder slug\"."

#: includes/class-rest.php:35
msgid "Could not reach Velora API."
msgstr ""

#: includes/class-rest.php:40
msgid "Too many submissions. Try again later."
msgstr ""

#: includes/class-rest.php:45
msgid "Plugin is not configured. Set API base and key in plugin settings."
msgstr ""

#: includes/view-settings.php:14
msgid "Configure the connection to your Velora breeder profile. The API key is required only for contact form submissions; read-only widgets (animals, gallery, listings, posts, events) work without one."
msgstr "Skonfiguruj połączenie z Twoim profilem hodowcy w Velorze. Klucz API jest wymagany tylko dla formularza kontaktowego; widgety tylko do odczytu (zwierzęta, galeria, oferta, aktualności, wystawy) działają bez niego."

#: includes/view-settings.php:23
msgid "API base URL"
msgstr "Adres URL API"

#: includes/view-settings.php:34
msgid "Velora external API base (no trailing slash)."
msgstr "Bazowy URL zewnętrznego API Velory (bez końcowego ukośnika)."

#: includes/view-settings.php:39
msgid "Profile base URL"
msgstr "Bazowy URL portalu"

#: includes/view-settings.php:50
msgid "Public Velora portal URL. Card/row clicks open profiles here."
msgstr "Publiczny URL portalu Velora. Kliknięcia w karty/wiersze otwierają tu pełne profile."

#: includes/view-settings.php:55
msgid "Default breeder slug"
msgstr "Domyślny slug hodowli"

#: includes/view-settings.php:66
msgid "Used when a shortcode omits the slug attribute."
msgstr "Używany, gdy shortcode nie podaje atrybutu slug."

#: includes/view-settings.php:71
msgid "API key (for contact form)"
msgstr "Klucz API (do formularza kontaktowego)"

#: includes/view-settings.php:84
msgid "Generate in Velora: Settings → Developers → Create API key. Must start with \"vk_live_\"."
msgstr "Wygeneruj w Velorze: Ustawienia → Developers → Utwórz klucz API. Musi zaczynać się od „vk_live_”."

