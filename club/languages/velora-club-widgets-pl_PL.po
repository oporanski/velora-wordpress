#. translators: %s is the club name returned by the Velora API.
#: includes/class-plugin.php:136
#, php-format
msgid "Club \"%s\" found, but no API key was entered — the contact form needs one and was not checked."
msgstr "Znaleziono klub \"%s\", ale nie podano klucza API — formularz kontaktowy go wymaga i nie został sprawdzony."

#: includes/class-plugin.php:139
msgid "The API key was rejected. Copy it again from the Velora panel, under Developers."
msgstr "Klucz API został odrzucony. Skopiuj go ponownie w Velorze: Ustawienia → Developers."

#. translators: %s is the club slug entered in the settings form.
